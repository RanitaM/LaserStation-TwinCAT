<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_Cylinder" Id="{3a08361c-e1ca-4cd5-94a2-58b649bee159}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Cylinder
VAR_INPUT
    xCmdWork   : BOOL;               // TRUE = go to AS, FALSE = go to GS
    xEnable    : BOOL;               // FALSE = both valves off
    xReset     : BOOL;               // acknowledge fault
    xSensWork  : BOOL;
    xSensHome  : BOOL;
    tTimeout   : TIME := T#3S;
END_VAR
VAR_OUTPUT
    xValveWork : BOOL;
    xValveHome : BOOL;
    xInWork    : BOOL;
    xInHome    : BOOL;
    xFault     : BOOL;
END_VAR
VAR
    fbTimeout  : TON;
    xMoving    : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[xInWork := xSensWork AND NOT xSensHome;
xInHome := xSensHome AND NOT xSensWork;

IF xReset THEN
    xFault := FALSE;
END_IF

IF NOT xEnable OR xFault THEN
    xValveWork := FALSE;
    xValveHome := FALSE;
ELSIF xCmdWork THEN
    xValveWork := TRUE;
    xValveHome := FALSE;
ELSE
    xValveWork := FALSE;
    xValveHome := TRUE;
END_IF

// travel-time / sensor plausibility supervision (also catches "both sensors active")
xMoving := (xValveWork AND NOT xInWork) OR (xValveHome AND NOT xInHome);
fbTimeout(IN := xMoving AND NOT xFault, PT := tTimeout);
IF fbTimeout.Q THEN
    xFault := TRUE;
END_IF]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>